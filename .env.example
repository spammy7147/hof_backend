# 각 보안 키에는 서로 다른 `openssl rand -base64 32` 결과를 사용한다.
HOF_AUTH_JWT_SECRET=<base64-encoded-32-byte-secret>
HOF_CREDENTIAL_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>
HOF_COOKIE_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>

# HTTPS reverse proxy가 없는 로컬 개발에서는 false, 운영 배포에서는 true로 설정한다.
HOF_AUTH_REFRESH_COOKIE_SECURE=false
HOF_AUTH_REQUIRE_HTTPS=false
HOF_AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# 홈서버 PostgreSQL과 Kafka 연결 정보다. 비밀번호는 Git에 커밋하지 않는다.
HOME_SERVER_IP=192.168.50.202
POSTGRES_USER=spammy
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=hof_db
SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.50.202:5432/hof_db
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=spammy
SPRING_KAFKA_BOOTSTRAP_SERVERS=192.168.50.202:9092
SPRING_PROFILES_ACTIVE=dev

# Redis는 자동화 예약 인덱스 가속용이며 기본값 false에서는 서버가 없어도 DB만으로 동작한다.
HOF_AUTOMATION_REDIS_ENABLED=false
# true로 바꾸는 경우 Spring Data Redis 접속 정보도 설정한다.
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379
HOF_AUTOMATION_RECONCILIATION_INTERVAL=30m
HOF_AUTOMATION_RECONCILIATION_JITTER=2m
HOF_AUTOMATION_DUE_POLL_DELAY=5000

# 0이면 시간별 옥션 관측 scheduler가 비활성화된다. 기존 암호화 계정 ID만 지정한다.
HOF_AUCTION_COLLECTOR_ACCOUNT_ID=0
HOF_AUCTION_COLLECTOR_CRON=0 0 * * * *

# APK는 202 서버의 /home/spammy/hof/releases를 컨테이너의 이 경로에 read-only mount한다.
HOF_RELEASE_STORAGE_ROOT=/var/lib/hof/releases
# 운영에서는 Jenkins Global Secret text `hof-spammy-publish-token`에서 주입한다.
# 로컬에서 등록 API를 시험할 때만 동일한 형식의 별도 테스트 값을 사용한다.
HOF_RELEASE_PUBLISH_TOKEN=<release-publish-token>

# 운영은 Jenkins가 SPRING_PROFILES_ACTIVE=prod와 Firebase Secret file mount를 제공한다.
# 서비스 계정 JSON 본문이나 GOOGLE_APPLICATION_CREDENTIALS는 로컬 dev env에 넣지 않는다.
